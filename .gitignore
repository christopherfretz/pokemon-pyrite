# compiled objects
*.o

# compiled graphics
*.1bpp
*.2bpp
*.lz
*.gbcpal
*.dimensions
*.animated.tilemap
*.sgb.tilemap
gfx/pokemon/*/bitmask.asm
gfx/pokemon/*/frames.asm
!gfx/pokemon/unown/bitmask.asm
!gfx/pokemon/unown/frames.asm

# compiled roms
*.gbc
*.gb
*.patch

# rgbds extras
*.map
*.sym

# tool binaries
*.exe

# precompiled python
*.pyc
*$py.class

# save game files
*.sgm
*.sav
*.rtc
*.sn*
*.sa*
*.sg1
# ...but the save editor's curated preset saves are committed on purpose
!web/presets/*.sav

# build id stamp
build_rev.txt

# generated by `make crystal` from the .sym + constants (see web/gen_tables.py)
web/tables.json
